<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/section_quality"
        android:layout_marginTop="@dimen/space_24" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorPrimary" />
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/preset_group"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8" app:singleSelection="true">
        <com.google.android.material.button.MaterialButton android:id="@+id/preset_fast" style="?attr/materialButtonOutlinedStyle" app:backgroundTint="@color/seg_bg" android:textColor="@color/seg_text" app:iconTint="@color/seg_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/touch_min" android:text="@string/preset_fast" />
        <com.google.android.material.button.MaterialButton android:id="@+id/preset_balanced" style="?attr/materialButtonOutlinedStyle" app:backgroundTint="@color/seg_bg" android:textColor="@color/seg_text" app:iconTint="@color/seg_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/touch_min" android:text="@string/preset_balanced" />
        <com.google.android.material.button.MaterialButton android:id="@+id/preset_sharp" style="?attr/materialButtonOutlinedStyle" app:backgroundTint="@color/seg_bg" android:textColor="@color/seg_text" app:iconTint="@color/seg_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/touch_min" android:text="@string/preset_sharp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <TextView android:id="@+id/preset_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />

    <View android:layout_width="match_parent" android:layout_height="@dimen/space_16" />
    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" />

    <LinearLayout android:id="@+id/pic_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="@dimen/space_8" android:paddingStart="@dimen/space_4" android:paddingEnd="@dimen/space_4"
        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/picture_settings"
            android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
        <ImageView android:id="@+id/pic_arrow" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_expand_more" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/pic_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone" android:paddingStart="@dimen/space_4" android:paddingEnd="@dimen/space_4">
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_cam"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" android:hint="@string/hint_camera">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dd_cam"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_res"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" android:hint="@string/hint_resolution">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dd_res"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_4">
            <com.google.android.material.chip.Chip android:id="@+id/chip_zoomed" style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/chip_zoomed" android:contentDescription="@string/chip_zoomed_why" android:visibility="gone" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_untested" style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/chip_untested" android:contentDescription="@string/chip_untested_why" android:visibility="gone" />
        </com.google.android.material.chip.ChipGroup>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_fps"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" android:hint="@string/hint_fps">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dd_fps"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" />

    <LinearLayout android:id="@+id/adv_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="@dimen/space_8" android:paddingStart="@dimen/space_4" android:paddingEnd="@dimen/space_4"
        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/advanced"
            android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
        <ImageView android:id="@+id/adv_arrow" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_expand_more" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/adv_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone" android:paddingStart="@dimen/space_4" android:paddingEnd="@dimen/space_4">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/appearance"
            android:layout_marginTop="@dimen/space_8" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/theme_group"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8"
            app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton android:id="@+id/theme_system" style="?attr/materialButtonOutlinedStyle" app:backgroundTint="@color/seg_bg" android:textColor="@color/seg_text" app:iconTint="@color/seg_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/touch_min" android:text="@string/theme_system" />
            <com.google.android.material.button.MaterialButton android:id="@+id/theme_light" style="?attr/materialButtonOutlinedStyle" app:backgroundTint="@color/seg_bg" android:textColor="@color/seg_text" app:iconTint="@color/seg_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/touch_min" android:text="@string/theme_light" />
            <com.google.android.material.button.MaterialButton android:id="@+id/theme_dark" style="?attr/materialButtonOutlinedStyle" app:backgroundTint="@color/seg_bg" android:textColor="@color/seg_text" app:iconTint="@color/seg_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="@dimen/touch_min" android:text="@string/theme_dark" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout android:id="@+id/row_guard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_8">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/protect_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/guard_support" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/protect_support"
                    android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/sw_guard"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16" android:contentDescription="@string/protect_title" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row_ll" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_8">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fast_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/ll_support" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fast_support"
                    android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/sw_ll"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16" android:contentDescription="@string/fast_title" />
        </LinearLayout>
        <LinearLayout android:id="@+id/row_dyn" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_8">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dyn_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/dyn_support" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dyn_support"
                    android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/sw_dyn"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16" android:contentDescription="@string/dyn_title" />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_br"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12" android:hint="@string/hint_bitrate">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dd_br"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min" android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_reset" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_8"
            android:minHeight="@dimen/touch_min" android:text="@string/reset_defaults" />
    </LinearLayout>
</LinearLayout>
