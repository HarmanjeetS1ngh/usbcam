<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:minHeight="@dimen/touch_min" android:paddingTop="@dimen/space_8" android:paddingBottom="@dimen/space_4">
    <TextView android:id="@+id/row_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
